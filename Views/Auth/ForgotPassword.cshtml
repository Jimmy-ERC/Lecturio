@model Lecturio.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_AuthLayout";
}

<h2 class="auth-title">Recupera tu contraseña</h2>
<p class="text-muted">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>

<form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="jimmy@gmail.com" autocomplete="email" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-brand w-100 py-2">Enviar enlace</button>

    <p class="text-center mt-3 mb-0">
        <a asp-controller="Auth" asp-action="Login">Volver a iniciar sesión</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
